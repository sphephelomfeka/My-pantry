<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/beige">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:id="@+id/formTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add ingredient"
            android:textColor="@color/olive"
            android:textSize="29sp"
            android:fontFamily="serif"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Record what is in your kitchen."
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:layout_marginTop="6dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="INGREDIENT NAME"
            android:textColor="@color/olive"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:layout_marginTop="26dp"/>
        <EditText
            android:id="@+id/nameInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="e.g. Tomatoes"
            android:singleLine="true"
            android:paddingHorizontal="14dp"
            android:background="@drawable/bg_card"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="QUANTITY"
            android:textColor="@color/olive"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:layout_marginTop="18dp"/>
        <EditText
            android:id="@+id/quantityInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="e.g. 4"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted"
            android:inputType="numberDecimal"
            android:singleLine="true"
            android:paddingHorizontal="14dp"
            android:background="@drawable/bg_card"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="UNIT"
            android:textColor="@color/olive"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:layout_marginTop="18dp"/>
        <EditText
            android:id="@+id/unitInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="e.g. pieces, g, ml"
            android:singleLine="true"
            android:paddingHorizontal="14dp"
            android:background="@drawable/bg_card"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EXPIRY DATE (OPTIONAL)"
            android:textColor="@color/olive"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:layout_marginTop="18dp"/>
        <EditText
            android:id="@+id/expiryInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="DD-MM-YYYY"
            android:singleLine="true"
            android:paddingHorizontal="14dp"
            android:background="@drawable/bg_card"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted"/>
        <Button
            android:id="@+id/saveIngredientButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="28dp"
            android:text="Save ingredient"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:background="@drawable/bg_button_olive"
            android:backgroundTint="@null"/>
        <Button
            android:id="@+id/cancelButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:background="@drawable/bg_button_white"
            android:backgroundTint="@null"/>
    </LinearLayout>
</ScrollView>
