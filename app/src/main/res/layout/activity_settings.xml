<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/beige">
    <include layout="@layout/view_topbar"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SETTINGS"
                android:textColor="@color/olive"
                android:textSize="30sp"
                android:fontFamily="serif"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Make your pantry work the way you like."
                android:textColor="@color/muted"
                android:textSize="14sp"
                android:layout_marginTop="6dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/bg_card"
                android:layout_marginTop="24dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Expiring-soon reminders"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Highlight ingredients with an expiry date coming up."
                    android:textColor="@color/muted"
                    android:textSize="13sp"
                    android:layout_marginTop="5dp"/>
                <Switch
                    android:id="@+id/expirySwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enable reminders"
                    android:textColor="@color/olive"
                    android:layout_marginTop="12dp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/bg_card"
                android:layout_marginTop="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="About My Pantry"
                    android:textColor="@color/olive"
                    android:textSize="18sp"
                    android:fontFamily="serif"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A simple kitchen companion designed to reduce food waste by suggesting recipes made only from ingredients you already have."
                    android:textColor="@color/muted"
                    android:textSize="14sp"
                    android:layout_marginTop="7dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_bottom_nav"/>
</LinearLayout>
