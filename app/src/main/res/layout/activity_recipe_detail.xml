<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/beige">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">
        <TextView
            android:id="@+id/detailBack"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:text="←  Back to recipes"
            android:textColor="@color/olive"
            android:textSize="14sp"/>
        <TextView
            android:id="@+id/detailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recipe name"
            android:textColor="@color/olive"
            android:textSize="30sp"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:layout_marginTop="12dp"/>
        <TextView
            android:id="@+id/detailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Made from what you have."
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:layout_marginTop="7dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_ingredients">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="INGREDIENTS"
                android:textColor="@color/yellow"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.14"/>
            <TextView
                android:id="@+id/detailIngredients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:lineSpacingExtra="7dp"
                android:layout_marginTop="12dp"/>
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The method"
            android:textColor="@color/olive"
            android:textSize="23sp"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:layout_marginTop="26dp"/>
        <TextView
            android:id="@+id/detailMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:lineSpacingExtra="7dp"
            android:layout_marginTop="10dp"/>
    </LinearLayout>
</ScrollView>
